<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.warpd.warpd</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{ if lookPath "warpd" }}{{ lookPath "warpd" }}{{ else if stat (printf "%s/bin/warpd" .chezmoi.homeDir) }}{{ .chezmoi.homeDir }}/bin/warpd{{ else }}/usr/local/bin/warpd{{ end }}</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/state/warpd.log</string>
    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/state/warpd.log</string>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
