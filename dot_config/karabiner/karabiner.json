{
    "global": {
        "check_for_updates_on_startup": true,
        "show_in_menu_bar": true,
        "show_profile_name_in_menu_bar": false,
        "ask_for_unknown_device_if_no_device_id_in_the_profile": false
    },
    "profiles": [
        {
            "complex_modifications": {
                "parameters": {
                    "basic.simultaneous_threshold_milliseconds": 50,
                    "basic.to_delayed_action_delay_milliseconds": 500,
                    "basic.to_if_alone_timeout_milliseconds": 1000,
                    "basic.to_if_held_down_threshold_milliseconds": 500,
                    "mouse_motion_to_scroll.speed": 100
                },
                "rules": [
                    {
                        "description": "Caps Lock as Super Key - Application Launcher",
                        "manipulators": [
                            {
                                "description": "Caps Lock + Z → Zen Browser",
                                "from": {
                                    "key_code": "z",
                                    "modifiers": { "mandatory": ["caps_lock"] }
                                },
                                "to": [{ "shell_command": "open -a 'Zen'" }],
                                "type": "basic"
                            },
                            {
                                "description": "Caps Lock + T → Microsoft Teams (Activity)",
                                "from": {
                                    "key_code": "t",
                                    "modifiers": { "mandatory": ["caps_lock"] }
                                },
                                "to": [
                                    {
                                        "shell_command": "open -a 'Microsoft Teams' && sleep 0.02 && osascript -e 'tell application \"Microsoft Teams\" to activate' -e 'tell application \"System Events\" to keystroke \"1\" using command down'"
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "description": "Caps Lock + C → Microsoft Teams (Calendar)",
                                "from": {
                                    "key_code": "c",
                                    "modifiers": { "mandatory": ["caps_lock"] }
                                },
                                "to": [
                                    {
                                        "shell_command": "open -a 'Microsoft Teams' && sleep 0.02 && osascript -e 'tell application \"Microsoft Teams\" to activate' -e 'tell application \"System Events\" to keystroke \"3\" using command down'"
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "description": "Caps Lock + F → Firefox",
                                "from": {
                                    "key_code": "f",
                                    "modifiers": { "mandatory": ["caps_lock"] }
                                },
                                "to": [{ "shell_command": "open -a 'Firefox' || open -a 'Zen'" }],
                                "type": "basic"
                            },
                            {
                                "description": "Caps Lock + S → Screens 5",
                                "from": {
                                    "key_code": "s",
                                    "modifiers": { "mandatory": ["caps_lock"] }
                                },
                                "to": [{ "shell_command": "open -a 'Screens 5'" }],
                                "type": "basic"
                            },
                            {
                                "description": "Caps Lock + M → Microsoft Outlook Mail Tab",
                                "from": {
                                    "key_code": "m",
                                    "modifiers": { "mandatory": ["caps_lock"] }
                                },
                                "to": [
                                    {
                                        "shell_command": "open -a 'Microsoft Outlook' && sleep 0.1 && osascript -e 'tell application \"Microsoft Outlook\" to activate' -e 'tell application \"System Events\" to keystroke \"1\" using command down'"
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "description": "Caps Lock + N → Microsoft Outlook Calendar Tab",
                                "from": {
                                    "key_code": "n",
                                    "modifiers": { "mandatory": ["caps_lock"] }
                                },
                                "to": [
                                    {
                                        "shell_command": "open -a 'Microsoft Outlook' && sleep 0.1 && osascript -e 'tell application \"Microsoft Outlook\" to activate' -e 'tell application \"System Events\" to keystroke \"2\" using command down'"
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "description": "Caps Lock + 1 → 1Password",
                                "from": {
                                    "key_code": "1",
                                    "modifiers": { "mandatory": ["caps_lock"] }
                                },
                                "to": [{ "shell_command": "open -a '1Password'" }],
                                "type": "basic"
                            },
                            {
                                "description": "Caps Lock + P → Privileges",
                                "from": {
                                    "key_code": "p",
                                    "modifiers": { "mandatory": ["caps_lock"] }
                                },
                                "to": [{ "shell_command": "open -a 'Privileges'" }],
                                "type": "basic"
                            },
                            {
                                "description": "Caps Lock + V → Visual Studio Code",
                                "from": {
                                    "key_code": "v",
                                    "modifiers": { "mandatory": ["caps_lock"] }
                                },
                                "to": [{ "shell_command": "open -a 'Visual Studio Code'" }],
                                "type": "basic"
                            },
                            {
                                "description": "Caps Lock + O → Obsidian",
                                "from": {
                                    "key_code": "o",
                                    "modifiers": { "mandatory": ["caps_lock"] }
                                },
                                "to": [{ "shell_command": "open -a 'Obsidian'" }],
                                "type": "basic"
                            },
                            {
                                "description": "Caps Lock + / → Super Key Cheat Sheet",
                                "from": {
                                    "key_code": "slash",
                                    "modifiers": { "mandatory": ["caps_lock"] }
                                },
                                "to": [{ "shell_command": "bash ~/.config/karabiner/super-cheatsheet.sh" }],
                                "type": "basic"
                            },
                            {
                                "description": "Caps Lock + Space → Ghostty",
                                "from": {
                                    "key_code": "spacebar",
                                    "modifiers": { "mandatory": ["caps_lock"] }
                                },
                                "to": [{ "shell_command": "open -a 'Ghostty' || open -a 'iTerm'" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Warpd Mouse Control via Caps Lock",
                        "manipulators": [
                            {
                                "description": "Caps Lock + W → Warpd Normal Mode",
                                "from": {
                                    "key_code": "w",
                                    "modifiers": { "mandatory": ["caps_lock"] }
                                },
                                "to": [
                                    {
                                        "key_code": "w",
                                        "modifiers": ["left_command", "left_option"]
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "description": "Caps Lock + G → Warpd Grid Mode",
                                "from": {
                                    "key_code": "g",
                                    "modifiers": { "mandatory": ["caps_lock"] }
                                },
                                "to": [
                                    {
                                        "key_code": "g",
                                        "modifiers": ["left_command", "left_option"]
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "description": "Caps Lock + X → Warpd Hint Mode",
                                "from": {
                                    "key_code": "x",
                                    "modifiers": { "mandatory": ["caps_lock"] }
                                },
                                "to": [
                                    {
                                        "key_code": "x",
                                        "modifiers": ["left_command", "left_option"]
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "description": "Caps Lock + Q → Warpd Oneshot Mode",
                                "from": {
                                    "key_code": "q",
                                    "modifiers": { "mandatory": ["caps_lock"] }
                                },
                                "to": [
                                    {
                                        "key_code": "q",
                                        "modifiers": ["left_command", "left_option"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "devices": [],
            "fn_function_keys": [
                {
                    "from": { "key_code": "f1" },
                    "to": [{ "consumer_key_code": "display_brightness_decrement" }]
                },
                {
                    "from": { "key_code": "f2" },
                    "to": [{ "consumer_key_code": "display_brightness_increment" }]
                },
                {
                    "from": { "key_code": "f3" },
                    "to": [{ "apple_vendor_keyboard_key_code": "mission_control" }]
                },
                {
                    "from": { "key_code": "f4" },
                    "to": [{ "apple_vendor_keyboard_key_code": "spotlight" }]
                },
                {
                    "from": { "key_code": "f5" },
                    "to": [{ "consumer_key_code": "dictation" }]
                },
                {
                    "from": { "key_code": "f6" },
                    "to": [{ "key_code": "f6" }]
                },
                {
                    "from": { "key_code": "f7" },
                    "to": [{ "consumer_key_code": "rewind" }]
                },
                {
                    "from": { "key_code": "f8" },
                    "to": [{ "consumer_key_code": "play_or_pause" }]
                },
                {
                    "from": { "key_code": "f9" },
                    "to": [{ "consumer_key_code": "fast_forward" }]
                },
                {
                    "from": { "key_code": "f10" },
                    "to": [{ "consumer_key_code": "mute" }]
                },
                {
                    "from": { "key_code": "f11" },
                    "to": [{ "consumer_key_code": "volume_decrement" }]
                },
                {
                    "from": { "key_code": "f12" },
                    "to": [{ "consumer_key_code": "volume_increment" }]
                }
            ],
            "name": "Default profile",
            "parameters": {
                "delay_milliseconds_before_open_device": 1000
            },
            "selected": true,
            "simple_modifications": [],
            "virtual_hid_keyboard": {
                "country_code": 0,
                "indicate_sticky_modifier_keys_state": true,
                "mouse_key_xy_scale": 100,
                "keyboard_type_v2": "ansi"
            }
        }
    ]
}
