# Warpd Configuration
# Optimized for keyboard-driven mouse control

# Activation keys
activation_key: A-M-c     # Command+Alt+C to activate normal mode
grid_key: A-M-g          # Command+Alt+G for grid mode
hint_key: A-M-x          # Command+Alt+X for hint mode
oneshot_key: A-M-o       # Command+Alt+O for oneshot mode

# Movement keys (vim-style)
up: k
down: j
left: h
right: l

# Speed control
accelerator: a           # Hold 'a' to move faster
decelerator: d          # Hold 'd' to move slower

# Mouse buttons
click: m                # Left click
rclick: comma           # Right click (,)
mclick: period          # Middle click (.)

# Drag mode
drag: v                 # Toggle drag mode

# Movement speed
speed: 220              # Base movement speed
acceleration: 4         # Acceleration multiplier
max_speed: 1000        # Maximum speed

# Grid mode settings
grid_size: 2            # 2x2 grid subdivision
grid_activation_key: space

# Hint mode settings
hint_bgcolor: #1e1e2e   # Background color for hints
hint_fgcolor: #f38ba8   # Foreground color for hints
hint_border_radius: 2   # Border radius for hint boxes

# Exit key
exit: escape            # Escape to exit any mode

# Screen edges (prevent cursor from going off screen)
scroll_speed: 20
buttons: M L R          # Middle, Left, Right click options

# Copy mode settings
copy_key: y             # Copy in hint mode

# History (for oneshot mode)
history_size: 100       # Remember last 100 positions