# Warpd Configuration
# Optimized for keyboard-driven mouse control

# Activation keys - using Command+Option combinations
activation_key: M-A-w
grid_key: M-A-g
hint_key: M-A-x
oneshot_key: M-A-q

# Movement keys (vim-style)
up: k
down: j
left: h
right: l

# Speed control
accelerator: a
decelerator: d

# Mouse buttons
click: m
rclick: comma
mclick: period

# Drag mode
drag: v

# Movement speed
speed: 220
acceleration: 4
max_speed: 1000

# Grid mode settings
grid_size: 2

# Hint mode settings
hint_bgcolor: #1e1e2e
hint_fgcolor: #f38ba8
hint_border_radius: 2

# Exit key
exit: esc

# Screen edges (prevent cursor from going off screen)
scroll_speed: 20
buttons: M L R

# Copy mode settings
copy_key: y

# History (for oneshot mode)
history_size: 100